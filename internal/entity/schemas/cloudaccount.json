{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CloudAccount",
  "description": "AWS account, GCP project, or Cloudflare account",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "provider": { "type": "string", "enum": ["aws", "gcp", "cloudflare"] },
    "accountId": { "type": "string" },
    "department": { "$ref": "#/$defs/ref" },
    "envType": { "type": "string", "enum": ["development", "qc", "staging", "production", "sandbox", "shared"] },
    "externalRefs": { "type": "array", "items": { "$ref": "#/$defs/externalRef" } }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name"],
      "properties": {
        "kind": { "type": "string" },
        "namespace": { "type": "string" },
        "name": { "type": "string" }
      }
    },
    "externalRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "id"],
      "properties": {
        "source": { "type": "string", "enum": ["terraform", "aws", "gcp", "cloudflare", "manual"] },
        "id": { "type": "string" },
        "tfAddress": { "type": "string" },
        "stateSource": { "type": "string" }
      }
    }
  }
}
