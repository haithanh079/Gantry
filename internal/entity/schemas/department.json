{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Department",
  "description": "Department, business unit, or platform organization",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "enum": ["department", "business-unit", "platform"]
    },
    "leads": {
      "type": "array",
      "items": { "type": "string" }
    },
    "slackChannel": { "type": "string" },
    "links": { "$ref": "#/$defs/links" }
  },
  "$defs": {
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url"],
        "properties": {
          "title": { "type": "string" },
          "url": { "type": "string" },
          "icon": {
            "type": "string",
            "enum": ["dashboard", "docs", "runbook", "github", "slack", "alert", "monitor", "ci", "other"]
          }
        }
      }
    }
  }
}
