{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Environment",
  "description": "Deployment target or cloud account",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "description": "Deprecated. Prefer CloudAccount.provider. Still accepted for existing catalogs.",
      "deprecated": true
    },
    "region": {
      "type": "string",
      "description": "Deprecated. Prefer Deployment.regions. Still accepted for existing catalogs.",
      "deprecated": true
    },
    "type": {
      "type": "string",
      "enum": ["staging", "production", "development", "qc", "sandbox"],
      "description": "Environment type"
    },
    "cluster": {
      "type": "string",
      "description": "Deprecated. Prefer Deployment.runtime.cluster. Still accepted for existing catalogs.",
      "deprecated": true
    },
    "accountId": {
      "type": "string",
      "description": "Deprecated. Prefer CloudAccount.accountId. Still accepted for existing catalogs.",
      "deprecated": true
    },
    "system": {
      "type": "string",
      "description": "Parent system or domain"
    },
    "dependsOn": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": { "type": "string" },
          "namespace": { "type": "string" },
          "name": { "type": "string" }
        },
        "required": ["kind", "name"]
      },
      "description": "Entities this environment depends on"
    },
    "providesApis": {
      "type": "array",
      "items": { "type": "string" },
      "description": "APIs provided by this entity"
    },
    "consumesApis": {
      "type": "array",
      "items": { "type": "string" },
      "description": "APIs consumed by this entity"
    }
  },
  "additionalProperties": false
}
